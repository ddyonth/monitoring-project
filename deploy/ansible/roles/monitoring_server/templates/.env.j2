# {{ ansible_managed }}
# Секреты и параметры для docker compose. Файл читается командой
# `docker compose` автоматически из рабочего каталога ({{ deploy_dir }}).
# Имена переменных — как в .env.example и docker-compose.yml репозитория.
MONITORING_API_KEY={{ monitoring_api_key }}
{% if monitoring_client_update_key is defined and monitoring_client_update_key %}
MONITORING_CLIENT_UPDATE_KEY={{ monitoring_client_update_key }}
{% endif %}
{# SMTP для email-уведомлений: опционально, без этих переменных сервер почту не шлёт #}
{% if monitoring_smtp_host is defined and monitoring_smtp_host %}
SMTP_HOST={{ monitoring_smtp_host }}
{% endif %}
{% if monitoring_smtp_port is defined and monitoring_smtp_port %}
SMTP_PORT={{ monitoring_smtp_port }}
{% endif %}
{% if monitoring_smtp_user is defined and monitoring_smtp_user %}
SMTP_USER={{ monitoring_smtp_user }}
{% endif %}
{% if monitoring_smtp_password is defined and monitoring_smtp_password %}
SMTP_PASSWORD={{ monitoring_smtp_password }}
{% endif %}
{% if monitoring_smtp_from is defined and monitoring_smtp_from %}
SMTP_FROM={{ monitoring_smtp_from }}
{% endif %}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ monitoring_postgres_password }}
POSTGRES_DB={{ postgres_db }}
