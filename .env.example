# Пример переменных окружения для секретов. Скопируйте в .env (он в .gitignore)
# или задайте переменные в окружении/systemd-юните. Реальные значения сюда не писать.

# Ключ API для приёма событий от агентов (сервер и клиент должны совпадать)
MONITORING_API_KEY=

# Ключ для раздачи обновлений клиента (только сервер)
MONITORING_CLIENT_UPDATE_KEY=
