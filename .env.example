# Пример переменных окружения для секретов. Скопируйте в .env (он в .gitignore)
# или задайте переменные в окружении/systemd-юните. Реальные значения сюда не писать.

# Ключ API для приёма событий от агентов (сервер и клиент должны совпадать)
MONITORING_API_KEY=

# Ключ для раздачи обновлений клиента (только сервер)
MONITORING_CLIENT_UPDATE_KEY=

# SMTP для email-уведомлений по алертам (только сервер, опционально).
# Отправка через STARTTLS. Обязательны SMTP_HOST и SMTP_FROM, иначе почта
# не отправляется (в журнале уведомлений будет «SMTP не настроен»);
# SMTP_PORT по умолчанию 587; SMTP_USER/SMTP_PASSWORD — если сервер требует
# авторизацию (оба сразу).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Postgres (docker-compose): пользователь и имя БД имеют значения по умолчанию
# (monitoring/monitoring), пароль обязателен
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=
POSTGRES_DB=monitoring

# Строка подключения сервера к БД (в docker-compose собирается автоматически
# из POSTGRES_*; нужна при запуске сервера вне compose)
# MONITORING_DATABASE_URL=postgresql://monitoring:пароль@localhost:5432/monitoring

# Тестовая БД для pytest (отдельная база в том же Postgres, создаётся тестами).
# Если не задана, тесты возьмут MONITORING_DATABASE_URL и добавят суффикс _test.
# MONITORING_TEST_DATABASE_URL=postgresql://monitoring:пароль@localhost:5432/monitoring_test

